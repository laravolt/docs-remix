{
  "name": "laravolt-docs",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "typecheck": "tsc --noEmit",
    "prerender": "node --import remix/node-tsx scripts/prerender.ts",
    "build": "npm run css && npm run prerender",
    "deploy": "npm run build && wrangler deploy",
    "css": "tailwindcss --input app/styles/tailwind.css --output public/styles.css --minify"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@markdoc/markdoc": "^0.5.11",
    "js-yaml": "^5.5.0",
    "prismjs": "1.30.0",
    "remix": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "latest",
    "@types/prismjs": "1.26.6",
    "tailwindcss": "4.3.3",
    "typescript": "latest",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
