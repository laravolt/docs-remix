{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laravolt-docs",
  "compatibility_date": "2026-08-09",
  // Serve only on laravolt.dev; the workers.dev preview duplicated every page.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Pages are served at /x (from x/index.html), the URL every internal link
    // and canonical tag uses; /x/ redirects to /x.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
